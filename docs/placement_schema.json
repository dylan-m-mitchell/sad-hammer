{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Placement Suggestion Schema",
  "type": "object",
  "required": ["event", "turn", "battleplan", "allowed_zones", "suggestions"],
  "properties": {
    "event": { "type": "string", "const": "placement" },
    "turn": { "type": "integer" },
    "battleplan": {
      "type": ["object", "null"],
      "properties": {
        "id": { "type": ["integer", "null"] },
        "title": { "type": ["string", "null"] }
      }
    },
    "allowed_zones": { "type": "array", "items": { "type": "string" } },
    "suggestions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["unit", "scores"],
        "properties": {
          "unit": { "type": "string" },
          "suggested_zone": { "type": ["string", "null"] },
          "reason": { "type": "string" },
          "scores": {
            "type": "object",
            "additionalProperties": { "type": "number" }
          },
          "priority": { "type": "string", "enum": ["High", "Medium", "Low"] },
          "zone_hint": { "type": "string" },
          "distance_range": {
            "type": "string",
            "enum": ["small", "medium", "deep"]
          },
          "coordinate_hint": { "type": "string" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
